extends ../components/base/layout

block variables
  - const title = "Пакет"
  - const wrapperMods = ""
  - const hasHeader = true
  - const headerMods = ""
  - const hasFooter = true
  - const footerMods = ""
  - const currentUrl = "index.html" //- для остальных страниц пишем пустую строку или индекс активного headerLinks


block main
  main.main
    +hero("Чем дольше — тем больше!")
      p.hero__description
        | Мы считаем каждый день вместе! Проверьте, сколько вы с «Пакетом», выигрывайте баллы «X5 Клуба» и ценные призы от Ситилинк.

      +participation-form("hero")
    +promo()
    +draw({
      type: "weekly",
      title: "Разыгрываем каждую среду",
      groups: weeklyPrizeGroups
    })

    +draw({
      type: "monthly",
      title: "Разыгрываем в сентябре",
      groups: monthlyPrizeGroups,
      hasParticipation: true
    })
    +winners-block()