extends ../components/base/layout

block variables
  - const title = "FindEdu"
  - const wrapperMods = ""
  - const hasHeader = true
  - const headerMods = ""
  - const hasFooter = true
  - const footerMods = ""
  - const currentUrl = "index.html" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
  main.main
    section.main__hero.hero
      div.container
        div.hero__wrapper
          div.hero__content
            h1.hero__title
              | FindEdu - все для выбора новой профессии в одном месте
            p.hero__description
              | Изучение тем на вебинарах с преподавателями, личные консультации с наставником. После прохождения курса с наставником. После прохождения курса
            a.hero__button.btn(href="#")
              span.hero__button-text
                | Сравнить курсы
              span.hero__button-icon
                +icon("icon-courses", 19, 19)
          div.hero__visual.visual
            +picture(
              "content",
              "title-picture",
              "png",
              578,
              646,
              ""
            )
            div.visual__rating.rating
              div.rating__content
                div.rating__container
                  div.rating__heading
                    h3.rating__title
                      | UX/UI designer
                    div.rating__stars(
                      role="img"
                      aria-label="Рейтинг: 5 из 5"
                    )
                      each star in [1, 2, 3, 4, 5]
                        +icon("icon-star", 13, 13)
                  p.rating__description
                    | UX/UI-дизайнер — одна из самых востребованных профессий 2020 года
                div.rating__wrapper
                  span.rating__salary
                    | 120 000 рублей
                  span.rating__employers
                    | 1 561 компания
              ul.rating__list
                li.rating__item
                  a.rating__link(
                    href="#"
                    aria-label="Перейти к курсам Skillbox"
                  )
                    +picture(
                      "content",
                      "skillbox",
                      "png",
                      24,
                      24,
                      "Skillbox"
                    )
                    span.rating__scale
                li.rating__item
                  a.rating__link(
                    href="#"
                    aria-label="Перейти к курсам SkillFactory"
                  )
                    +picture(
                      "content",
                      "skill-factory",
                      "png",
                      24,
                      24,
                      "SkillFactory"
                    )
                    span.rating__scale
                li.rating__item
                  a.rating__link(
                    href="#"
                    aria-label="Перейти к курсам GeekBrains"
                  )
