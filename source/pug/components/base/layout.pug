doctype html

include ../components

block variables

html(lang="ru")
  head
    title= title

    meta(charset="utf-8")
    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )
    meta(
      http-equiv="X-UA-Compatible"
      content="ie=edge"
    )
    meta(
      name="description"
      content="FindEdu — платформа для выбора образовательных курсов"
    )

    link(
      rel="icon"
      href="/favicon/favicon.svg"
      type="image/svg+xml"
    )
    link(
      rel="icon"
      href="/favicon/favicon-96x96.png"
      type="image/png"
      sizes="96x96"
    )
    link(
      rel="apple-touch-icon"
      href="/favicon/apple-touch-icon.png"
      sizes="180x180"
    )
    meta(
      name="apple-mobile-web-app-title"
      content="FindEdu"
    )
    link(
      rel="manifest"
      href="/favicon/site.webmanifest"
      crossorigin="use-credentials"
    )

    //- Используем только для шрифта, находящегося на первом экране
    link(
      rel="preload"
      href="fonts/inter-v11-latin_cyrillic-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    )

    //- Разметка Open Graph
    if (openGraf)
      meta(
        property="og:title"
        content="FindEdu"
      )
      meta(
        property="og:image"
        content="https://24fortest.ru/img/content/sharing.png"
      )
      meta(
        property="og:type"
        content="website"
      )
      meta(
        property="og:url"
        content="https://24fortest.ru/"
      )
      meta(
        property="og:description"
        content="FindEdu — платформа для выбора образовательных курсов"
      )

    link(
      rel="stylesheet"
      href="css/style.min.css"
    )

  body
    .wrapper(class=wrapperMods)
      if (hasHeader)
        +header(headerMods, currentUrl)

      block main

      if (hasFooter)
        +footer(footerMods)

    script(src="js/vendor.min.js")
    script(src="js/main.min.js")