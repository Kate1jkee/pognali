mixin header(headerMods, currentUrl)
  header.header(class=headerMods)
    .container
      .header__wrapper
        if currentUrl === "index.html"
          .header__logo
            img(
              src="img/content/logo-ligth.svg"
              width="202"
              height="50"
              alt="Погнали"
            )
        else
          a.header__logo(href="index.html")
            img(
              src="img/content/logo_full.svg"
              width="202"
              height="50"
              alt="Погнали — на главную"
            )

        nav.header__nav(aria-label="Основная навигация")
          ul.header__nav-list
            li.header__nav-item
              a.header__nav-link(href="#") О сервисе
            li.header__nav-item
              a.header__nav-link(href="#") Направления
            li.header__nav-item
              a.header__nav-link(href="catalog.html") Попутчики

        .header__contacts
          a.header__contact(
            href="#"
            aria-label="Позвонить"
          )
            img(
              src="img/content/icon_call.svg"
              width="18"
              height="18"
              alt=""
            )
          a.header__contact(
            href="#"
            aria-label="Написать письмо"
          )
            img(
              src="img/content/icon_mail.svg"
              width="16"
              height="14"
              alt=""
            )