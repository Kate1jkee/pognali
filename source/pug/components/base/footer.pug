mixin footer(footerMods)
  footer.footer(class=footerMods)
    .container
      .footer__wrapper
        .footer__info
          img.footer__logo(
            src="img/svg/x5-logo.svg"
            width="20"
            height="15"
            alt="X5"
          )

          p.footer__copyright 
            | © 2021 2023 ООО «Корпоративный центр ИКС 5»

        nav.footer__nav(aria-label="Документы")
          ul.footer__list
            li.footer__item
              a.footer__link(href="#")
                | Политика конфиденциальности

            li.footer__item
              a.footer__link(href="#")
                | Пользовательское соглашение

            li.footer__item
              a.footer__link(href="#")
                | Правила акции