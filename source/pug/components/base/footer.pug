mixin footer(footerMods)
  footer.footer(class=footerMods)
    .container
      .footer__wrapper
        .footer__info
          .footer__logo
            img(
              src="img/svg/x5-logo.svg"
              width="56"
              height="40"
              alt="X5"
            )

          p.footer__copyright 
            | © 2021 2023 
            br 
            | ООО «Корпоративный центр ИКС 5»

        nav.footer__nav(aria-label="Документы")
          ul.footer__list
            li.footer__item
              a.footer__link(href="#")
                | Политика конфиденциальности

            li.footer__item
              a.footer__link(href="#")
                | Пользовательское соглашение

            li.footer__item
              a.footer__link(href="#")
                | Правила акции