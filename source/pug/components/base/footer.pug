mixin footer(footerMods)
  -
    const footerCategories = [
      { text: "Дизайн", href: "#" },
      { text: "Программирование", href: "#" },
      { text: "Маркетинг", href: "#" },
      { text: "Менеджмент", href: "#" },
      { text: "Аналитика", href: "#" }
    ];

  -
    const footerDirections = [
      { text: "Web-разработка", href: "#" },
      { text: "Java-разработка", href: "#" },
      { text: "Python-разработка", href: "#" },
      { text: "SMM-продвижение", href: "#" },
      { text: "Графический дизайн", href: "#" },
      { text: "Дизайн интерьеров", href: "#" }
    ];

  -
    const footerInfoLinks = [
      { text: "О проекте", href: "#" },
      { text: "Политика конфиденциальности", href: "#" },
      { text: "Пользовательское соглашение", href: "#" }
    ]; 

  -
    const footerGroups = [
      {
        title: "Категории",
        id: "footer-categories-title",
        links: footerCategories
      },
      {
        title: "Популярные направления",
        id: "footer-directions-title",
        links: footerDirections
      },
      {
        title: "Общая информация",
        id: "footer-info-title",
        links: footerInfoLinks
      }
    ];

  footer.footer(class=footerMods)
    div.container
      div.footer__wrapper
        div.footer__info
          a.footer__logo(
            href="index.html"
            aria-label="Перейти на главную страницу"
          )
            img(
              src="img/content/logo.svg"
              width="34"
              height="39"
              alt="FindEdu"
            )
            span.footer__logo-text
              | FindEdu
          p.footer__copyright
            | © FindEdu 2022.
            span.footer__rights
              | Все права защищены.

        each group in footerGroups
          nav.footer__nav(aria-labelledby=group.id)
            h2.footer__title(id=group.id)= group.title

            ul.footer__list
              each link in group.links
                li.footer__item
                  a.footer__link(href=link.href)= link.text