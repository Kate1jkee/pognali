mixin footer(footerMods)

  footer.footer(class=footerMods)
    div.container
      div.footer__wrapper
        div.footer__info
          a.footer__logo(
            href="index.html"
            aria-label="Перейти на главную страницу"
          )
            img(
              src="img/content/logo.svg"
              width="35"
              height="41"
              alt="FindEdu"
            )
            span.footer__logo-text
              | FindEdu
          p.footer__copyright
            | © FindEdu 2022.
            span.footer__rights
              | Все права защищены.

        each group in footerGroups
          nav.footer__nav(
            class=`footer__nav--${group.modifier}`
            aria-labelledby=group.id
          )
            h2.footer__title(id=group.id)= group.title

            ul.footer__list
              each link in group.links
                li.footer__item
                  a.footer__link(href=link.href)= link.text