mixin footer(footerMods)
  footer.footer(class=footerMods)
    .container
      .footer__wrapper
        a.footer__logo(href="index.html")
          img(
            src="img/content/logo_full.svg"
            width="202"
            height="50"
            alt="Погнали — на главную"
          )

        ul.footer__socials(aria-label="Социальные сети")
          each social in socials
            li.footer__social-item
              a.footer__social-link(
                href=social.href
                aria-label=social.name
              )
                img(
                  src=`img/content/${social.icon}.svg`
                  width="32"
                  height="32"
                  alt=""
                )