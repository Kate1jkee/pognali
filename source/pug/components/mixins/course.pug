mixin course(direction)
  div.course&attributes(attributes)
    a.course__link(href=direction.href)
      div.course__heading
        +picture(
          "content",
          direction.image,
          "png",
          direction.width,
          direction.height,
          ""
        )
        h3.course__title= direction.title

      ul.course__topics
        each row in direction.topics
          li.course__topic
            each topic, index in row
              if index > 0
                +icon("icon-separator", 16, 16)

              span.course__topic-text= topic