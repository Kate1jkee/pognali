mixin course(direction)
  li.course&attributes(attributes)
    a.course__link(href=direction.href)
      div.course__heading
        +picture(
          "content",
          direction.image,
          "png",
          direction.width,
          direction.height,
          ""
        )
        h3.course__title= direction.title

      ul.course__topics
        each topic, index in direction.topics
          li.course__topic
            span.course__topic-text= topic

            if index < direction.topics.length - 1
              +icon("icon-separator", 16, 16)