mixin prize-card(card)
  .prize-card(class=`prize-card--${card.theme}`)
    .prize-card__header(
      class=card.logo === "citilink-logo" ? "prize-card__header--citilink" : null
    )
      .prize-card__logo(class=`prize-card__logo--${card.logo}`)
        img(
          src=`img/svg/${card.logo}.svg`
          alt=card.logoAlt
        )

      if card.logo === "citilink-logo"
        .prize-card__info
          img(
            src="img/svg/info-icon.svg"
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          )

      if card.count
        span.prize-card__count= card.count

    h4.prize-card__title= card.title

    p.prize-card__description
      each line, index in card.textLines
        if index > 0
          br
        = line

    if card.image
      .prize-card__visual
        img(
          src=`img/content/${card.image}.png`
          srcset=`img/content/${card.image}@2x.png 2x`
          alt=""
        )