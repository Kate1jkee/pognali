mixin directions-card(card)
  article.directions-card
    .directions-card__content
      h3.directions-card__title= card.name

      p.directions-card__description= card.description

      p.directions-card__travellers
        +icon("icon-user", 27, 24).directions-card__travellers-icon
        span.visually-hidden Количество попутчиков:
        span.directions-card__likes= card.travellers

    .directions-card__image
      +img(
        "content", card.image, "png", null, null, ""
      )

    .directions-card__flag.tooltip(
              data-tooltip=card.name
            )
      +img(
        "content", card.flag, "png", null, null, ""
      )