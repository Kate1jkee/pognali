mixin intro(title)
  section.intro
    .intro__background
       +img("content", "hero-background-desktop", "png", 1440, 750, "")

    .container
      .intro__wrapper
        .intro__content
          h1.intro__title= title

          .intro__image
            picture
              source(
                media="(max-width: 1023px)"
                srcset="img/content/traveller-tablet.svg"
                width="437"
                height="530"
              )
              img(
                src="img/content/traveller-desktop.svg"
                width="431"
                height="640"
                alt=""
              )

        ol.intro__steps
          each step, index in introSteps
            li.intro__step(
              class=`intro__step--${step.modifier}`
              style=`--step-delay: ${index * 450}ms`
            )
              p.intro__step-text= step.text