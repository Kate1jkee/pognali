mixin intro(title)
  section.intro
    .intro__background
      img(
        src="img/content/hero-background-desktop.png"
        srcset="img/content/hero-background-desktop@2x.png 2x"
        width="1440"
        height="742"
        alt=""
      )

    .container
      .intro__wrapper
        .intro__content
          h1.intro__title= title

          .intro__image
            img(
              src="img/content/traveller-desktop.png"
              srcset="img/content/traveller-desktop@2x.png 2x"
              width="431"
              height="640"
              alt=""
            )

        ol.intro__steps
          each step in introSteps
            li.intro__step(class=`intro__step--${step.modifier}`)
              p.intro__step-text= step.text