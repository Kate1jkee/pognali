mixin mainNav()
  -
    const mainNavLinks = [
      { text: "Главная", href: "#", isActive: true },
      { text: "Курсы", href: "#", isActive: false },
      { text: "Блог", href: "#", isActive: false }
    ];

  nav.main-nav(
    aria-label="Основная навигация"
  )&attributes(attributes)

    span.main-nav__mobile-title
      | Курсы

    button.main-nav__toggle(
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="courses-menu"
    )
      +icon("icon-burger", 22, 12).main-nav__toggle-icon.main-nav__toggle-icon--burger
      +icon("icon-close", 24, 24).main-nav__toggle-icon.main-nav__toggle-icon--close

    ul.main-nav__list
      each link in mainNavLinks
        li.main-nav__item
          a.main-nav__link(
            class=link.isActive ? "main-nav__link--active" : ""
            href=link.href
            aria-current=link.isActive ? "page" : false
          )= link.text