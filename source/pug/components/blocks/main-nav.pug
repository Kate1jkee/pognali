mixin mainNav()

  nav.main-nav(
    aria-label="Основная навигация"
  )&attributes(attributes)

    span.main-nav__mobile-title
      | Курсы

    button.main-nav__toggle(
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="courses-menu"
      data-menu-toggle
    )
      +icon("icon-burger", 22, 12).main-nav__toggle-icon.main-nav__toggle-icon--burger
      +icon("icon-close", 24, 24).main-nav__toggle-icon.main-nav__toggle-icon--close

    ul.main-nav__list
      each link in mainNavLinks
        li.main-nav__item
          - const isActive = link.href === currentUrl
            a.main-nav__link(
              class=isActive ? "main-nav__link--active" : ""
              href=link.href
              aria-current=isActive ? "page" : false
            )= link.text