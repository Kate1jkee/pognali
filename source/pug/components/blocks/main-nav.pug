mixin mainNav(currentUrl)
  nav.main-nav(
    aria-label="Основная навигация"
  )&attributes(attributes)

    span.main-nav__mobile-title
      | Курсы

    button.main-nav__toggle.btn-reset(
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="courses-menu"
      data-menu-toggle
    )
      +icon("icon-burger", 22, 12).main-nav__toggle-icon.main-nav__toggle-icon--burger
      +icon("icon-close", 24, 24).main-nav__toggle-icon.main-nav__toggle-icon--close

    ul.main-nav__list
      each link in mainNavLinks
        - const activeState = currentUrl === link.href

        li.main-nav__item
          if activeState
            span.main-nav__link.main-nav__link--active.is-active(
              aria-current="page"
            )= link.text
          else
            a.main-nav__link(
              href=link.href
            )= link.text