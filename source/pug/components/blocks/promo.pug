mixin promo()
  -
    const advantages = [
      {
        title: "Довольные пользователи",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-user",
        width: 26,
        height: 26
      },
      {
        title: "Образовательные курсы",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-courses",
        width: 19,
        height: 19
      },
      {
        title: "Менторы из больших компаний",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-mentor",
        width: 14,
        height: 21
      }
    ];

  section.main__promo.promo
    div.container
      div.promo__wrapper
        h2.promo__title
          | Агрегируем курсы по самым актуальным темам для новичков и практикующих специалистов.
        div.promo__content
          div.promo__overview
            +picture(
              "content",
              "user",
              "png",
              277,
              249,
              ""
            )
            h3.promo__subtitle
              | 300+ довольных пользователей
            p.promo__description
              | Дополнительно в этом методе есть кнопка «Объединить по строкам». С помощью неё можно объединить ячейки выбранного диапазона построчно.

          div.promo__advantages.advantages
            ul.advantages__list
              each item in advantages
                +advantage(item)(class="advantages__item")