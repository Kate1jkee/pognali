mixin promo()
  -
    const promoCards = [
      {
        modifier: "users",
        image: "user",
        width: 424,
        height: 383,
        title: "300+ довольных пользователей",
        description: "Дополнительно в этом методе есть кнопка «Объединить по строкам». С помощью неё можно объединить ячейки выбранного диапазона построчно.",
        isActive: true
      },
      {
        modifier: "courses",
        image: "courses",
        width: 424,
        height: 424,
        title: "1000+ образовательных курсов",
        description: "Дополнительно в этом методе есть кнопка «Объединить по строкам». С помощью неё можно объединить ячейки выбранного диапазона построчно."
      },
      {
        modifier: "mentors",
        image: "mentor",
        width: 424,
        height: 424,
        title: "20+ менторов больших компаний",
        description: "Дополнительно в этом методе есть кнопка «Объединить по строкам». С помощью неё можно объединить ячейки выбранного диапазона построчно."
      }
    ];

    const advantages = [
      {
        title: "Довольные пользователи",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-user",
        width: 26,
        height: 26,
        isActive: true
      },
      {
        title: "Образовательные курсы",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-courses",
        width: 19,
        height: 19
      },
      {
        title: "Менторы из больших компаний",
        description: "Изучение тем на вебинарах с преподавателями, наставником. После прохождения курса вы будете",
        icon: "icon-mentor",
        width: 14,
        height: 21
      }
    ];

  section.main__promo.promo
    div.container
      div.promo__wrapper
        h2.promo__title
          | Агрегируем курсы по самым актуальным темам для новичков и практикующих специалистов.

        div.promo__content
          each card in promoCards
            div.promo__overview(
              class=`promo__overview--${card.modifier}${card.isActive ? " promo__overview--active" : ""}`
            )
              +picture(
                "content",
                card.image,
                "png",
                card.width,
                card.height,
                ""
              )

              h3.promo__subtitle= card.title
              p.promo__description= card.description

          div.promo__advantages.advantages
            ul.advantages__list
              each item in advantages
                +advantage(item)(
                  class=`advantages__item${item.isActive ? " advantage--active" : ""}`
                )

        div.promo__controls
          button.promo__control.promo__control--prev(
            type="button"
            aria-label="Показать предыдущую карточку"
          )
            +icon("icon-back", 7, 12)

          button.promo__control.promo__control--next(
            type="button"
            aria-label="Показать следующую карточку"
          )
            +icon("icon-back", 7, 12)