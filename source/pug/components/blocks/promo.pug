mixin promo()

  section.main__promo.promo(data-promo)
    div.container
      div.promo__wrapper
        h2.promo__title
          | Агрегируем курсы по самым актуальным темам для новичков и практикующих специалистов.

        div.promo__content
          each card in promoCards
            div.promo__overview(
              class=card.isActive ? "is-active" : null
              data-promo-card
            )
              +picture(
                "content",
                card.image,
                "png",
                card.width,
                card.height,
                ""
              )

              h3.promo__subtitle= card.title
              p.promo__description= card.description

          div.promo__advantages.advantages
            ul.advantages__list
              each item in advantages
                +advantage(item)(
                  class=item.isActive ? "is-active" : null
                  data-promo-item
                )

    .swiper.promo__slider
      .swiper-wrapper
        each card in promoCards
          .swiper-slide.promo__slide
            div.promo__overview(
              class=card.isActive ? "is-active" : null
              data-promo-card
            )
              +picture(
                "content",
                card.image,
                "png",
                card.width,
                card.height,
                ""
              )

              h3.promo__subtitle= card.title
              p.promo__description= card.description

      div.promo__controls    
        button.promo__control.promo__control--prev(   
          type="button"
          aria-label="Показать предыдущую карточку"
        )
          +icon("icon-back", 7, 12)
      
        button.promo__control.promo__control--next(
          type="button"
          aria-label="Показать следующую карточку"
        )
          +icon("icon-back", 7, 12)