mixin winners-hero()
  section.winners-hero
    img.winners-hero__background(
        src="img/content/gradient-desktop.png"
        srcset="img/content/gradient-desktop@2x.png 2x"
        width="1440"
        height="655"
        alt=""
        aria-hidden="true"
      )
    .container
      .winners-hero__wrapper
        .winners-hero__content
          h1.winners-hero__title Победители акции

          +winners-search()

        .winners-hero__visual
          img.winners-hero__image(
            src="img/content/hero-image-desktop.png"
            srcset="img/content/hero-image-desktop@2x.png 2x"
            width="654"
            height="649"
            alt=""
          )