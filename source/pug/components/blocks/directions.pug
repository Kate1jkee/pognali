mixin directions()
  section.directions(aria-labelledby="directions-title")
    .container
      .directions__wrapper
        .directions__slider
          .directions__viewport(data-directions-slider)
            ul.directions__list
              each card in directionsCards
                li.directions__item
                  +directions-card(card)

        .directions__content
          h2.directions__title#directions-title Направления

          p.directions__description
            | Мы не&nbsp;продаем туры и&nbsp;ничего не рекламируем. 
            br
            | Люди сами пишут о&nbsp;странах, куда хотели бы отправиться и&nbsp;чем можно там заняться.

          a.directions__link.btn(href="catalog.html")
            span Показать все