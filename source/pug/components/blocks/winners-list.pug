mixin winners-list()
  - const weeklyGroup = winnersGroups.find((group) => group.type === 'week')
  - const monthlyGroup = winnersGroups.find((group) => group.type === 'month')
  - const weeklyDraws = weeklyGroup.draws

  section.winners-list
    .container
      h2.winners-list__title Список победителей

      .winners-list__types
        button.winners-list__type.btn(
          type="button"
          data-winners-type="weekly"
          aria-pressed="true"
        )= weeklyGroup.title

        button.winners-list__type.btn(
          type="button"
          data-winners-type="monthly"
          aria-pressed="false"
        )= monthlyGroup.title

      .winners-list__filter
        button.winners-list__toggle.btn(
          type="button"
          aria-expanded="false"
          aria-controls="winners-dates"
          data-winners-toggle
        )
          span(data-winners-selected)= weeklyDraws[0].label

        ul.winners-list__options(
          id="winners-dates"
          data-winners-options
          hidden
        )
          each draw, index in weeklyDraws
            li.winners-list__option
              button.winners-list__date(
                type="button"
                data-winners-date=draw.id
                aria-pressed=index === 0 ? "true" : "false"
              )= draw.label


      dialog.winners-list__dialog(
        aria-label="Выберите розыгрыш"
        data-winners-dialog
      )

      .winners-list__results
        each draw, index in weeklyDraws
          .winners-list__result(
            data-winners-result=draw.id
            data-winners-group="weekly"
            hidden=index !== 0
          )
            .winners-list__heading
              h3.winners-list__week(id=`${draw.id}-title`)= draw.title

              p.winners-list__dates
                = `${draw.dateFrom} — ${draw.dateTo}`

            +winners-table(draw.winners, `${draw.id}-title`)

        .winners-list__result(
          data-winners-result="monthly"
          data-winners-group="monthly"
          hidden
        )
          .winners-list__heading
            h3.winners-list__week(id="monthly-title")= monthlyGroup.title

          +winners-table(monthlyGroup.winners, "monthly-title")


mixin winners-table(winners, titleId)
  .winners-list__scroll
    table.winners-list__table(aria-labelledby=titleId)
      thead
        tr
          th(scope="col") Имя
          th(scope="col") Телефон
          th(scope="col") Приз

      tbody
        each winner in winners
          tr.winners-list__row(data-winner-phone=winner.phone)
            td= winner.name
            td= winner.phone
            td= winner.prize