mixin winners-list()
  section.winners-list
    .container
      h2.winners-list__title Список победителей

      .winners-list__types
        button.winners-list__type.btn(
          type="button"
          data-winners-type="weekly"
          aria-pressed="true"
        ) Еженедельные

        button.winners-list__type.btn(
          type="button"
          data-winners-type="monthly"
          aria-pressed="false"
        ) Розыгрыш в сентябре

      .winners-list__filter
        button.winners-list__toggle.btn(
          type="button"
          aria-expanded="false"
          aria-controls="winners-dates"
          data-winners-toggle
        )
          span(data-winners-selected)= winnersDraws[0].label

        ul.winners-list__options(
          id="winners-dates"
          data-winners-options
          hidden
        )
          each draw, index in winnersDraws
            li.winners-list__option
              button.winners-list__date(
                type="button"
                data-winners-date=draw.id
                aria-pressed=index === 0 ? "true" : "false"
              )= draw.label

      .winners-list__results
        each draw, index in winnersDraws
          .winners-list__result(
            data-winners-result=draw.id
            hidden=index !== 0
          )
            .winners-list__heading
              h3.winners-list__week(id=`${draw.id}-title`)
                = `${draw.week} неделя`

              p.winners-list__dates
                = `${draw.dateFrom} — ${draw.dateTo}`

            .winners-list__scroll
              table.winners-list__table(
                aria-labelledby=`${draw.id}-title`
              )
                thead
                  tr
                    th(scope="col") Имя
                    th(scope="col") Телефон
                    th(scope="col") Приз

                tbody
                  each winner in draw.winners
                    tr.winners-list__row(
                      data-winner-phone=winner.phone
                    )
                      td= winner.name
                      td= winner.phone
                      td= winner.prize