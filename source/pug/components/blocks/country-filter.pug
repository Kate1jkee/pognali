mixin country-filter()
  section.country-filter(
    aria-labelledby="country-filter-title"
    data-country-filter
  )
    .country-filter__heading
      .container
        h1.country-filter__title#country-filter-title Попутчики

    .country-filter__body
      .container
        .country-filter__wrapper
          .country-filter__header
            button.country-filter__toggle(
              type="button"
              aria-expanded="false"
              aria-controls="country-filter-panel"
              data-country-filter-toggle
            )
              +icon("icon-burger", 23, 15)
              span Фильтрация по странам:
              span.country-filter__mobile-indicator(aria-hidden="true")

            ul.country-filter__continents
              each continent in filterContinents
                li.country-filter__continent
                  label.country-filter__continent-label
                    input(
                      type="checkbox"
                      name="continents[]"
                      value=continent.id
                      checked=continent.id === "europe"
                      data-continent-checkbox
                    )
                    span.country-filter__continent-text= continent.name

            button.country-filter__show(
              type="button"
              aria-expanded="false"
              aria-controls="country-filter-panel"
              data-country-filter-show
            )
              span(
                data-country-filter-show-text
                data-text-open="Свернуть"
                data-text-closed="Показать все"
              ) Показать все

              span.country-filter__show-open
                +icon("icon-point", 33.41, 6)

              span.country-filter__show-close
                +icon("icon-esc", 22, 22)

          .country-filter__panel#country-filter-panel(
            hidden
            data-country-filter-panel
          )
            ul.country-filter__groups
              each group, index in filterCountryGroups
                li.country-filter__group(data-country-group)
                  h2.country-filter__letter
                    button.country-filter__letter-button(
                      type="button"
                      data-country-letter
                      aria-controls="country-letter-list-" + index
                    )= group.letter

                  ul.country-filter__countries(
                    id="country-letter-list-" + index
                  )
                    each country in group.countries
                      li.country-filter__country
                        button.country-filter__country-button(
                          type="button"
                          data-country=country.id
                          aria-pressed="false"
                        )= country.name

            button.country-filter__close(
              type="button"
              data-country-filter-close
            )
              span Свернуть