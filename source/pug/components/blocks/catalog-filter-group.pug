mixin catalog-filter-group(group)
  details.catalog-filter-group(open=group.open)
    summary.catalog-filter-group__heading= group.title

    .catalog-filter-group__options
      each option in group.options
        label.catalog-filter-group__option
          input.catalog-filter-group__checkbox(
            type="checkbox"
            name=group.name
            value=option.value
            checked=option.checked
          )
          span= option.label