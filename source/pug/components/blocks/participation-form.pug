mixin participation-form(idPrefix)
  form.participation-form(
    action="#"
    method="post"
    data-participation-form
  )
    label.participation-form__agreement(
      for=`${idPrefix}-agreement`
    )
      input.participation-form__checkbox(
        type="checkbox"
        id=`${idPrefix}-agreement`
        name="agreement"
        value="accepted"
        required
        data-participation-checkbox
      )

      span.participation-form__text
        | Я согласен на#{' '}
        a.participation-form__link(
          href="#"
          data-participation-link
        ) участие в акции
        
    button.participation-form__button.btn(
      type="submit"
      data-participation-button
    )
      span.participation-form__button-text
        | Принять участие