mixin rates()
  section.rates(aria-labelledby="rates-title")
    .container
      .rates__wrapper
        h2.rates__title#rates-title Добавьте свой профиль

        .rates__content
          ol.rates__list
            each item in ratesItems
              li.rates__item
                span.rates__name= item.title
                span.rates__price= item.price

          .rates__image
            img(
              src="img/content/rates.png"
              srcset="img/content/rates@2x.png 2x"
              alt=""
            )

        button.rates__business(
          type="button"
          aria-haspopup="dialog"
        )
          span.rates__business-icon
            +icon("icon-business", 29, 28)
          span.rates__modal Показать тарифы для бизнеса