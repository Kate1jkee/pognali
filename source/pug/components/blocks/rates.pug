mixin rates()
  section.rates(aria-labelledby="rates-title")
    .container
      .rates__wrapper
        h2.rates__title#rates-title Добавьте свой профиль

        .rates__content
          .rates__list-block
            ol.rates__numbers(aria-hidden="true")
              each item in ratesItems
                li.rates__number

            ol.rates__list
              each item in ratesItems
                li.rates__item
                  span.rates__name
                    span.rates__name-text= item.title
          .rates__details
            ul.rates__prices
              each item in ratesItems
                li.rates__price= item.price

            .rates__image
              img(
                src="img/content/rates.svg"
                width="200"
                height="202"
                alt=""
              )

        button.rates__business(
          type="button"
          aria-haspopup="dialog"
          aria-controls="business-rates-modal"
          data-business-rates-open
        )
          span.rates__business-icon
            +icon("icon-business", 29, 28)
          span.rates__modal Показать тарифы для бизнеса