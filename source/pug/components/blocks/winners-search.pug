mixin winners-search()
  .winners-search(data-winners-search-wrapper)
    form(
      action="#"
      method="get"
      aria-labelledby="winner-search-title"
      data-winners-search
    )
      h2.winners-search__title(id="winner-search-title")
        | Поиск по номеру телефона

      .winners-search__field
        label.winners-search__label(for="winner-phone")
          span.visually-hidden Номер телефона

          input(
            type="text"
            id="winner-phone"
            name="phone"
            inputmode="numeric"
            pattern="[0-9]{4}"
            maxlength="4"
            required
            aria-describedby="winner-phone-hint winner-phone-error"
            data-winners-input
          )

        button.winners-search__button(
          type="submit"
          aria-label="Найти победителя"
          data-winners-submit
        )
          img(
            src="img/svg/search-icon.svg"
            width="32"
            height="32"
            alt=""
          )

        button.winners-search__clear(
          type="button"
          aria-label="Очистить номер телефона"
          data-winners-clear
          hidden
        )

      p.winners-search__description(id="winner-phone-hint")
        | Введите последние 4 цифры номера телефона

      p.winners-search__error(
        id="winner-phone-error"
        aria-live="polite"
        data-winners-error
        hidden
      ) Номер не найден