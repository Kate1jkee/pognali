mixin hero()
  section.hero
    .container
      .hero__wrapper
        .hero__content
          h1.hero__title
            | Чем дольше — тем больше!

          p.hero__description
            | Мы считаем каждый день вместе! Проверьте, сколько вы с «Пакетом», выигрывайте баллы «X5 Клуба» и ценные призы от Ситилинк.

          +participation-form("hero")

        .hero__visual
          img.hero__image(
            src="img/content/hero-image.png"
            srcset="img/content/hero-image@2x.png 2x"
            alt=""
          )