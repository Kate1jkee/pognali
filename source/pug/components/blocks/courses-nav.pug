mixin coursesNav()
  -
    const coursesNavOrder = [
      "design",
      "programming",
      "analytics",
      "management",
      "marketing",
      "finance"
    ];
  nav.courses-nav(
    aria-label="Направления обучения"
  )&attributes(attributes)
    ul.courses-nav__list
      each modifier in coursesNavOrder
        - const direction = courseDirections.find((item) => item.modifier === modifier)
        li.courses-nav__item
          button.courses-nav__link.btn-reset(
            type="button"
            aria-expanded="false"
            aria-controls=`courses-dropdown-${direction.modifier}`
          )
            span.courses-nav__text= direction.title
            span.courses-nav__icon(aria-hidden="true")

          div.courses-nav__dropdown(
            id=`courses-dropdown-${direction.modifier}`
            hidden
          )
            ul.courses-nav__dropdown-list
              each row in direction.topics
                each topic in row
                  li.courses-nav__dropdown-item
                    a.courses-nav__dropdown-link(href="#")= topic