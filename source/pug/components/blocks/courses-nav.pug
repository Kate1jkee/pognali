mixin coursesNav()
  nav.courses-nav(
    aria-label="Направления обучения"
    data-courses-nav
  )&attributes(attributes)

    ul.courses-nav__list
      each direction in coursesNavDirections
        li.courses-nav__item(
          class=`courses-nav__item--${direction.modifier}`
        )
          button.courses-nav__link.btn-reset(
            id=`${direction.id}-button`
            type="button"
            aria-expanded="false"
            aria-controls=direction.id
            data-courses-nav-button
          )
            span.courses-nav__text= direction.title
            span.courses-nav__icon(aria-hidden="true")

          div.courses-nav__dropdown(
            id=direction.id
            aria-labelledby=`${direction.id}-button`
            data-courses-nav-dropdown
            hidden
          )
            ul.courses-nav__dropdown-list
              each course in direction.courses
                li.courses-nav__dropdown-item
                  a.courses-nav__dropdown-link(href="#")= course