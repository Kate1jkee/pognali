mixin registration()
  section.registration(aria-labelledby="registration-title")
    .registration__main
      .container
        .registration__wrapper
          h2.registration__title#registration-title Заинтересовались?

          p.registration__description
            | Зарегистрируйтесь, это быстро и бесплатно!

          p.registration__login
            | Уже зарегистрированы? Тогда скорее
            |
          a.registration__login-link(href="#") авторизуйтесь.

          form.registration__form(
            action="#"
            method="post"
            novalidate
            data-registration-form
          )
            .registration__field
              label.visually-hidden(for="registration-email") Электронная почта

              input#registration-email(
                type="email"
                name="email"
                placeholder="E-mail"
                autocomplete="email"
                required
                aria-describedby="registration-error"
                data-registration-email
              )

              p.registration__error#registration-error(
                aria-live="polite"
                data-registration-error
              )

            button.registration__submit.btn(type="submit")
              span Регистрация

          p.registration__questions
            | Остались вопросы? Мы с радостью на них ответим!

          ul.registration__contacts
            li.registration__contact
              a.registration__contact-link(
                href="tel:+78005558628"
                aria-label="Позвонить: 8 800 555-86-28"
              )
                span.registration__contact-icon
                  +icon("icon-number", 36, 34)
                span.registration__contact-text 8 800 555-86-28

            li.registration__contact
              a.registration__contact-link(href="mailto:mail@htmlacademy.ru")
                span.registration__contact-icon
                  +icon("icon-email", 47, 50)
                span.registration__contact-text MAIL@HTMLACADEMY.RU

    .registration__location
      .container
        .registration__location-wrapper
          p.registration__address
            span.registration__address-icon
              +icon("icon-map", 32, 42)
            span ул. Большая Конюшенная, 19/8

          a.registration__route.btn(href="#")
            span Проложить маршрут

    .registration__map(
      data-office-map
      data-map-key="d8c83788-b6de-4ac8-bbd6-887380951110"
      data-map-address="Санкт-Петербург, Большая Конюшенная улица, 19/8"
      data-map-latitude="59.938814"
      data-map-longitude="30.323016"
      data-map-zoom="16"
      data-map-pin="img/sprite.svg#icon-pin"
    )
      +img(
        "content",
        "map",
        "png",
        1440,
        584,
        "Карта расположения офиса: Санкт-Петербург, Большая Конюшенная улица, 19/8"
      )

      .registration__map-canvas(
        data-map-canvas
        hidden
        role="region"
        aria-label="Интерактивная карта расположения офиса"
      )