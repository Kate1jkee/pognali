mixin catalog-card(card)
  article.catalog-card
    .catalog-card__image
      img(
        src=`img/content/${card.image}.png`
        srcset=`img/content/${card.image}@2x.png 2x`
        width="285"
        height="285"
        alt=card.name
      )

    .catalog-card__content
      h3.catalog-card__name
        span.catalog-card__status(
          class=card.online ? "catalog-card__status--online" : "catalog-card__status--offline"
        )
          span.visually-hidden= card.online ? "В сети" : "Не в сети"
        span= card.name

      ul.catalog-card__tags(aria-label="Интересы")
        each tag in card.tags
          li.catalog-card__tag= "#" + tag

      .catalog-card__actions
        span.catalog-card__invite Позвать!

        .catalog-card__likes
          label.catalog-card__like
            input(
              type="checkbox"
              aria-label=`Нравится профиль ${card.name}`
            )
            span.catalog-card__like-icon
              +icon("icon-heart", 23, 20)

              svg(
                width="23"
                height="20"
                viewBox="0 0 23 20"
                aria-hidden="true"
              )
                path(
                  fill="currentColor"
                  d="M11.5 19 2.2 9.7C-3.2 4.3 4.5-3 9.5 2.2L11.5 4.3 13.5 2.2C18.5-3 26.2 4.3 20.8 9.7Z"
                )

          span.visually-hidden Количество отметок «Нравится»:
          span.catalog-card__like-number= card.likes

    .catalog-card__details
      ul.catalog-card__countries(aria-label="Хочет посетить")
        each country in card.countries
          li.catalog-card__country
            span.catalog-card__flag.tooltip(
              data-tooltip=country.name
            )
              img(
                src=`img/content/${country.flag}.png`
                alt=""
              )
            span.catalog-card__country-name= country.name

      .catalog-card__footer
        ul.catalog-card__transport(aria-label="Предпочитаемый транспорт")
          each transport in companionsTransport
            - const isActive = card.transport.includes(transport.id)
            li.catalog-card__transport-item.tooltip(
              class=isActive ? "catalog-card__transport-item--active" : null
              data-tooltip=transport.name
            )
              +icon(transport.icon, transport.width, transport.height)
              span.visually-hidden
                = transport.name + (isActive ? " — выбран" : " — не выбран")

        .catalog-card__level(aria-label=`Уровень: ${card.level} из 100`)
          svg(width="60" height="60" viewBox="0 0 60 60" aria-hidden="true")
            circle(
              cx="30"
              cy="30"
              r="28"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              pathLength="100"
              stroke-dasharray=`${card.level} 100`
              transform="rotate(-90 30 30)"
            )
          span.catalog-card__level-value(aria-hidden="true")= card.level
          span.catalog-card__level-text(aria-hidden="true") level